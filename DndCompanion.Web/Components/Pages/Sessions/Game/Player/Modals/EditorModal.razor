@using DndCompanion.Application.Features.Characters.Resources.ChangeCharacterResource
@using DndCompanion.Application.Features.Characters.Resources.SetCharacterResource
@using DndCompanion.Application.Features.Characters.Resources.SetCharacterResourceMax
@using Domain.Entities

@inject IServiceScopeFactory ScopeFactory

@if (_modalOpen && _resource is not null)
{ 
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit @_resource.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                </div>

                <div class="modal-body">
                    @if (_error is not null)
                    {
                        <div class="alert alert-danger mt-2">@_error</div>
                    }
                    <div class="mb-1">
                        <span class="small text-muted">Current</span>
                        <div class="fs-5 fw-bold">@FormatResource(_resource)</div>
                    </div>

                    @if (IsGlobalEdit)
                    {
                        <div class="text-muted mb-1">Set new maximum</div>
                        <div class="input-group">
                            <input type="number" class="form-control" @bind="_setMaxValue"/>
                            <button class="btn btn-secondary" @onclick="ApplySetMax" disabled="@_isBusy">
                                Set max
                            </button>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="fillToMax" @bind="_fillToMax"/>
                            <label class="form-check-label" for="fillToMax">
                                Fill to new maximum
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="btn-group mb-1" role="group">
                            <button
                                class="btn btn-outline-primary @(_editMode == EditMode.Change ? "active" : string.Empty)"
                                @onclick="() => _editMode = EditMode.Change">
                                Change
                            </button>
                            <button
                                class="btn btn-outline-primary @(_editMode == EditMode.Set ? "active" : string.Empty)"
                                @onclick="() => _editMode = EditMode.Set">
                                Set
                            </button>
                        </div>

                        @if (_editMode == EditMode.Change)
                        {
                            <div class="text-muted mb-1">Adjust value with buttons, or change it manually (e.g.
                                +13/-8)
                            </div>
                            <div class="mb-2 d-flex flex-wrap gap-2">
                                <button class="btn btn-outline-danger" @onclick="() => ExecuteChangeAsync(-10)"
                                        disabled="@_isBusy">-10
                                </button>
                                <button class="btn btn-outline-danger" @onclick="() => ExecuteChangeAsync(-5)"
                                        disabled="@_isBusy">-5
                                </button>
                                <button class="btn btn-outline-danger" @onclick="() => ExecuteChangeAsync(-1)"
                                        disabled="@_isBusy">-1
                                </button>
                                <button class="btn btn-outline-success" @onclick="() => ExecuteChangeAsync(1)"
                                        disabled="@_isBusy">+1
                                </button>
                                <button class="btn btn-outline-success" @onclick="() => ExecuteChangeAsync(5)"
                                        disabled="@_isBusy">+5
                                </button>
                                <button class="btn btn-outline-success" @onclick="() => ExecuteChangeAsync(10)"
                                        disabled="@_isBusy">+10
                                </button>
                            </div>

                            <div class="input-group">
                                <input type="number" class="form-control" @bind="_changeDelta"/>
                                <button class="btn btn-primary" @onclick="() => ExecuteChangeAsync(_changeDelta)"
                                        disabled="@_isBusy">Apply
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted mb-1">Set current value to a specific value</div>
                            <div class="input-group mb-2">
                                <input type="number" class="form-control" @bind="_setCurrentValue"/>
                                <button class="btn btn-primary" @onclick="ApplySetCurrent" disabled="@_isBusy">Set
                                    current
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public Guid ParticipantId { get; set; }
    [Parameter] public bool IsGlobalEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public Resource? Resource { get; set; }

    private enum EditMode
    {
        Change,
        Set
    }

    private bool _modalOpen = false;

    private bool _isBusy;
    private string? _error;

    private Resource? _resource;
    private EditMode _editMode = EditMode.Change;
    private bool _fillToMax = true;

    private int _changeDelta = 1;
    private int _setCurrentValue;
    private int _setMaxValue;
    
    protected override void OnParametersSet()
    {
        if (Resource is not null)
            _resource = Resource;
    }

    public void Open()
    {
        _changeDelta = 1;
        
        if (Resource is not null)
        {
            _setCurrentValue = Resource.CurrentValue;
            _setMaxValue = Resource.MaxValue;
        }
        
        _editMode = EditMode.Change;
        _modalOpen = true;
        _error = null;

        StateHasChanged();
    }

    private Task ExecuteChangeAsync(int delta) => ExecuteAsync(async () =>
    {
        using var scope = ScopeFactory.CreateScope();
        var service = scope.ServiceProvider.GetRequiredService<ChangeCharacterResourceService>();
        var result = await service.ExecuteAsync(
            new ChangeCharacterResourceCommand(ParticipantId, _resource!.Type, _resource.Name, delta));
        return (result.IsSuccess, result.ErrorMessage, result.CurrentValue);
    });

    private Task ApplySetCurrent() => ExecuteAsync(async () =>
        {
            using var scope = ScopeFactory.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<SetCharacterResourceService>();
            var result = await service.ExecuteAsync(
                new SetCharacterResourceCommand(ParticipantId, _resource!.Type, _resource.Name, _setCurrentValue));
            return (result.IsSuccess, result.ErrorMessage, result.CurrentValue);
        },
        closeOnSuccess: true);

    private Task ApplySetMax() => ExecuteAsync(async () =>
        {
            using var scope = ScopeFactory.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<SetCharacterResourceMaxService>();
            var result = await service.ExecuteAsync(
                new SetCharacterResourceMaxCommand(ParticipantId, _resource!.Type, _resource.Name, _setMaxValue, _fillToMax));
            return (result.IsSuccess, result.ErrorMessage, result.CurrentValue);
        },
        closeOnSuccess: true);


    private async Task ExecuteAsync(Func<Task<(bool IsSuccess, string? ErrorMessage, int? CurrentValue)>> action, bool closeOnSuccess = false)
    {
        _isBusy = true;
        _error = null;

        var (isSuccess, errorMessage, currentValue) = await action();

        _isBusy = false;

        if (!isSuccess)
        {
            _error = errorMessage;
            return;
        }

        if (currentValue.HasValue)
            _setCurrentValue = currentValue.Value;

        await OnSaved.InvokeAsync();

        if (closeOnSuccess)
            CloseEditor();
    }

    private void CloseEditor()
    {
        _modalOpen = false;
        _error = null;
    }

    private string FormatResource(Resource? resource)
    {
        return resource is null ? "-" : $"{resource.CurrentValue}/{resource.MaxValue}";
    }

}