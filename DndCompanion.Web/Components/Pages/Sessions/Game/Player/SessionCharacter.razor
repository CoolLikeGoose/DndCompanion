@page "/sessions/{SessionId:guid}/character"
@using DndCompanion.Application.Abstractions.Persistence
@using DndCompanion.Application.Features.Characters.Resources.AddAbilitySlot
@using DndCompanion.Application.Features.Characters.Resources.ApplyRest
@using Web.Components.Shared
@using Domain.Entities
@using Web.Components.Pages.Sessions.Game.Player.Modals
@using Web.Components.Pages.Sessions.Game.Player.Models
@using Domain.Enums

@inject ISessionRepository SessionRepository

@inject SessionNotificationService SessionNotificationService
@inject IServiceScopeFactory ScopeFactory

@inject AddAbilitySlotService AddAbilitySlotService
@inject ApplyRestService ApplyRestService

@implements IDisposable

@if (_loadFailed)
{
    <div class="alert alert-danger" role="alert">Failed to reload participants</div>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div>
                        <h2 class="mb-0">@_participant!.Character!.Name</h2>
                        <span class="badge bg-secondary">@_participant.Role</span>
                    </div>
                    <div class="ms-auto">
                        <div class="btn-group">
                            <button class="btn btn-primary" @onclick="() => ApplyRest(true)" disabled="@_isBusy">Long Rest</button>
                            <button class="btn btn-primary dropdown-toggle"
                                    @onclick="() => _restDropdownOpen = !_restDropdownOpen"
                                    @onblur="() => _restDropdownOpen = false">
                            </button>
                            
                            @if (_restDropdownOpen)
                            {
                                <div class="dropdown-menu show w-100"
                                     style="position:absolute; top: 100%; left: 0;">
                                    <button class="dropdown-item" @onclick="() => ApplyRest(false)">Short Rest</button>
                                </div>
                            }
                        </div>
                        <button class="btn btn-primary" @onclick="() => _globalEdit = !_globalEdit">
                            @(_globalEdit ? "Cancel" : "Edit Resources")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_resourceError))
                {
                    <div class="alert alert-danger" role="alert">@_resourceError</div>
                }

                @* Core resources *@
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="card bg-light h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0">Core resources</h5>
                                </div>

                                @{
                                    var hp = FindResource(ResourceType.HitPoints, StaticResourceNames.HitPoints);
                                }
                                <ResourceCard
                                    Resource="hp"
                                    IsGlobalEditMode="_globalEdit"
                                    Disabled="_isBusy"
                                    OnEditClick='() => OpenEditorModal(ResourceType.HitPoints, StaticResourceNames.HitPoints)'/>

                                @{
                                    var hitDice = FindResource(ResourceType.HitDice, StaticResourceNames.HitDice);
                                }
                                <ResourceCard
                                    Resource="hitDice"
                                    IsGlobalEditMode="_globalEdit"
                                    Disabled="_isBusy"
                                    OnEditClick='() => OpenEditorModal(ResourceType.HitDice, StaticResourceNames.HitDice)'/>

                                @if (hp is not null && hp.CurrentValue <= 0)
                                {
                                    var successfulDeathThrows = _participant?.Character?.DeathSavesSuccesses ?? 0;
                                    var failedDeathThrows = _participant?.Character?.DeathSavesFailures ?? 0;

                                    <div class="card mt-2 border-danger">
                                        <div class="card-body py-2">
                                            <div class="small fw-semibold text-danger mb-2">
                                                Death Saving Throws
                                            </div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="text-muted" style="width: 60px;">Success</span>
                                                @for (int i = 0; i < 3; i++)
                                                {
                                                    var filled = i < successfulDeathThrows;
                                                    <span style="
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 50%;
                                                        display: inline-block;
                                                        border: 2px solid #198754;
                                                        background: @(filled ? "#198754" : "transparent");"></span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="text-muted" style="width: 60px;">Failure</span>
                                                @for (int i = 0; i < 3; i++)
                                                {
                                                    var filled = i < failedDeathThrows;
                                                    <span style="
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 50%;
                                                        display: inline-block;
                                                        border: 2px solid #dc3545;
                                                        background: @(filled ? "#dc3545" : "transparent");"></span>
                                                }
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger mt-2 w-100"
                                                    @onclick="OpenAddThrowModal">
                                                Add Throw
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Ability slots *@
                    <div class="col-12 col-md-6">
                        <div class="card bg-light">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0">Abilities</h5>
                                </div>

                                @foreach (var group in _participant!.Character!.Resources
                                                  .Where(r => r.Type == ResourceType.AbilitySlot)
                                                  .GroupBy(r => r.Group ?? "Abilities")
                                                  .OrderBy(g => g.Key))
                                {
                                    <div>
                                        @* <div class="col-12 col-md-6"> *@
                                        @*     <div class="card bg-light"> *@
                                        @*         <div class="card-body"> *@
                                        <h6 class="text-muted mb-2">@group.Key</h6>
                                        @foreach (var resource in group)
                                        {
                                            <ResourceCard
                                                Resource="resource"
                                                Disabled="_isBusy"
                                                IsGlobalEditMode="_globalEdit"
                                                OnEditClick='() => OpenEditorModal(ResourceType.AbilitySlot, resource.Name)'/>
                                        }
                                        @if (_globalEdit)
                                        {
                                            <button class="btn btn-sm btn-outline-primary w-100 h-100 mb-2"
                                                    @onclick="() => OpenAddAbilityModal(group.Key)">
                                                + New ability
                                            </button>
                                        }
                                    </div>
                                }

                                @if (_globalEdit)
                                {
                                    <button class="btn btn-outline-secondary w-100 h-100"
                                            @onclick="() => OpenAddAbilityModal(null)">
                                        + New group
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @* Other staff *@
                    <div class="col-6 col-md-3">
                        <div class="card text-center bg-light">
                            <div class="card-body py-3">
                                <div class="fs-4 fw-bold text-muted">—</div>
                                <div class="small text-muted">WIP</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<EditorModal @ref="_editorModal" ParticipantId="ParticipantId" IsGlobalEdit="_globalEdit" OnSaved="HandleSaved"/>

<AddAbilityModal @ref="_addAbilityModal" IsBusy="_isBusy" OnAdd="HandleAddAbility"/>

<AddThrowModal @ref="_addThrowModal" ParticipantId="ParticipantId" OnSaved="HandleAddThrow"/>

<SessionNavBar SessionId="SessionId" ParticipantId="ParticipantId"/>

@code {
    [Parameter] public Guid SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "participantId")]
    public Guid ParticipantId { get; set; }

    private SessionParticipant? _participant;
    private bool _loadFailed;
    private bool _isBusy;
    private string? _resourceError;

    // editor
    private bool _globalEdit = false;
    private EditorModal _editorModal = null!;

    // ability
    private AddAbilityModal _addAbilityModal = null!;

    protected override async Task OnInitializedAsync()
    {
        await ReloadParticipantAsync();
        await SessionNotificationService.NotifyAsync(
            new SessionEvent(SessionEventType.SessionUpdated, SessionId, ParticipantId)
        );
        SessionNotificationService.Subscribe(SessionId, OnSessionUpdated);
    }

    private async Task OnSessionUpdated(SessionEvent sessionEvent)
    {
        if (sessionEvent.ParticipantId != ParticipantId)
            return;
        if (sessionEvent.Type != SessionEventType.ResourcesUpdated)
            return;

        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<ISessionRepository>();
        _participant = await repo.FindParticipantByIdAsync(ParticipantId);
        await InvokeAsync(StateHasChanged);
    }

    private Resource? FindResource(ResourceType type, string? name)
    {
        return _participant?.Character?.Resources
            .FirstOrDefault(x => x.Type == type && x.Name == name);
    }

    // Ability
    private void OpenAddAbilityModal(string? group)
    {
        _addAbilityModal.Open(group);
    }

    private async Task HandleAddAbility(AddAbilityData data)
    {
        _isBusy = true;
        var result = await AddAbilitySlotService.ExecuteAsync(
            new AddAbilitySlotCommand(ParticipantId, data.Name, data.Group, data.MaxValue, data.RecoveryType));
        _isBusy = false;

        if (!result.IsSuccess)
        {
            _resourceError = result.ErrorMessage;
            return;
        }

        await ReloadParticipantAsync();
    }

    // Editor
    private void OpenEditorModal(ResourceType type, string name)
    {
        var resource = FindResource(type, name);
        if (resource is null)
        {
            _resourceError = $"{name} resource is not initialized yet.";
            return;
        }

        _editorModal.Open(resource);
    }

    private async Task HandleSaved()
    {
        await ReloadParticipantAsync();
        await SessionNotificationService.NotifyAsync(
            new SessionEvent(SessionEventType.ResourcesUpdated, SessionId, ParticipantId)
        );
    }

    private async Task ReloadParticipantAsync()
    {
        _loadFailed = false;
        _participant = await SessionRepository.FindParticipantByIdAsync(ParticipantId);

        if (_participant is not null && _participant.SessionId != SessionId)
        {
            _participant = null;
            _loadFailed = true;
        }

        _resourceError = null;
    }

    // Death saving throws
    private AddThrowModal _addThrowModal = null!;

    private void OpenAddThrowModal()
    {
        _addThrowModal.Open(_participant?.Character?.DeathSavesSuccesses ?? 0, _participant?.Character?.DeathSavesFailures ?? 0);
    }

    private async Task HandleAddThrow(bool isSuccess)
    {
        await ReloadParticipantAsync();
        await SessionNotificationService.NotifyAsync(
            new SessionEvent(SessionEventType.DeathThrowsUpdated, SessionId, ParticipantId,
                new DeathThrowLogEntry(DateTime.UtcNow, _participant!.Character!.Name, isSuccess))
        );
    }

    // Rest options 
    private bool _restDropdownOpen = false;
    
    
    private async Task ApplyRest(bool isLong = true)
    {
        _isBusy = true;
        _resourceError = null;

        var result = await ApplyRestService.ExecuteAsync(
            new ApplyRestCommand(ParticipantId, isLong ? RecoveryType.LongRest : RecoveryType.ShortRest, true));

        _isBusy = false;

        if (!result.IsSuccess)
        {
            _resourceError = result.ErrorMessage;
            return;
        }
        
        _restDropdownOpen = false;

        await ReloadParticipantAsync();
        await SessionNotificationService.NotifyAsync(
            new SessionEvent(SessionEventType.ResourcesUpdated, SessionId, ParticipantId)
        );
    }

    public void Dispose()
    {
        SessionNotificationService.Unsubscribe(SessionId, OnSessionUpdated);
    }

}