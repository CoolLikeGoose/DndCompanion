@page "/sessions/{SessionId:guid}/info"
@using DndCompanion.Application.Abstractions.Persistence
@using DndCompanion.Application.Features.Characters.UpdateInfo
@using DndCompanion.Application.Features.Characters.UpdateStats
@using Domain.Entities
@using Web.Components.Pages.Sessions.Game.Shared

@inject ISessionRepository SessionRepository

@inject UpdateInfoService UpdateInfoService
@inject UpdateStatsService UpdateStatsService

@if (_participant?.Character is not null)
{
    <div class="container py-3 pb-5">
        <div class="d-flex align-items-center mb-3">
            <h2 class="mb-0">@_participant.Character.Name</h2>
            <div class="ms-auto">
                <button class="btn @(_editMode ? "btn-warning" : "btn-outline-secondary")"
                        @onclick="() => _editMode = !_editMode">
                    @(_editMode ? "Done" : "Edit")
                </button>
            </div>
        </div>
        
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        @* Stats *@
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="text-muted mb-3">Stats</h5>
                <div class="row g-2 text-center">
                    @foreach (var stat in GetStats())
                    {
                        <div class="col-4">
                            <div class="small text-muted">@stat.Label</div>
                            @if (_editMode)
                            {
                                <input type="number" class="form-control form-control-sm text-center"
                                       value="@stat.Value"
                                       @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var value)) SetStat(stat.Label, value);}"/>
                            }
                            else
                            {
                                <div class="fs-5 fw-semibold">@stat.Value</div>
                                <div class="small text-muted">@GetModifier(stat.Value)</div>
                            }
                        </div>
                    }
                </div>
                @if (_editMode)
                {
                    <button class="btn btn-primary w-100 mt-3" @onclick="SaveStats" disabled="@_isBusy">Save stats
                    </button>
                }
            </div>
        </div>

        @* Info *@
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="text-muted mb-3">Character Info</h5>
                @if (_editMode)
                {
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Class</label>
                            <input class="form-control" @bind="_formClass"/>
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Level</label>
                            <input type="number" class="form-control" @bind="_formLevel" min="1" max="20"/>
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Age</label>
                            <input type="number" class="form-control" @bind="_formAge"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Race</label>
                            <input class="form-control" @bind="_formRace"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Alignment</label>
                            <input class="form-control" @bind="_formAlignment"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Background</label>
                            <input class="form-control" @bind="_formBackground"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Experience Points</label>
                            <input type="number" class="form-control" @bind="_formExperiencePoints"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Personality Traits</label>
                            <textarea class="form-control" @bind="_formPersonalityTraits" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Ideals</label>
                            <textarea class="form-control" @bind="_formIdeals" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Bonds</label>
                            <textarea class="form-control" @bind="_formBonds" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Flaws</label>
                            <textarea class="form-control" @bind="_formFlaws" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Language Proficiencies</label>
                            <input class="form-control" @bind="_formLanguageProficiencies"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Tool Proficiencies</label>
                            <input class="form-control" @bind="_formToolProficiencies"/>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 mt-3" @onclick="SaveInfo" disabled="@_isBusy">Save info
                    </button>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-6"><span class="text-muted small">Class</span>
                            <div>@(_participant.Character.Info?.Class ?? "—")</div>
                        </div>
                        <div class="col-3"><span class="text-muted small">Level</span>
                            <div>@(_participant.Character.Info?.Level?.ToString() ?? "—")</div>
                        </div>
                        <div class="col-3"><span class="text-muted small">Age</span>
                            <div>@(_participant.Character.Info?.Age?.ToString() ?? "—")</div>
                        </div>
                        <div class="col-6"><span class="text-muted small">Race</span>
                            <div>@(_participant.Character.Info?.Race ?? "—")</div>
                        </div>
                        <div class="col-6"><span class="text-muted small">Alignment</span>
                            <div>@(_participant.Character.Info?.Alignment ?? "—")</div>
                        </div>
                        <div class="col-6"><span class="text-muted small">Background</span>
                            <div>@(_participant.Character.Info?.Background ?? "—")</div>
                        </div>
                        <div class="col-6"><span class="text-muted small">XP</span>
                            <div>@(_participant.Character.Info?.ExperiencePoints?.ToString() ?? "—")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_participant.Character.Info?.PersonalityTraits))
                    {
                        <div class="mt-2"><span class="text-muted small">Personality Traits</span>
                            <div>@_participant.Character.Info.PersonalityTraits</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_participant.Character.Info?.Ideals))
                    {
                        <div class="mt-2"><span class="text-muted small">Ideals</span>
                            <div>@_participant.Character.Info.Ideals</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_participant.Character.Info?.Bonds))
                    {
                        <div class="mt-2"><span class="text-muted small">Bonds</span>
                            <div>@_participant.Character.Info.Bonds</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_participant.Character.Info?.Flaws))
                    {
                        <div class="mt-2"><span class="text-muted small">Flaws</span>
                            <div>@_participant.Character.Info.Flaws</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<SessionNavBar SessionId="SessionId" ParticipantId="ParticipantId"/>

@code {
    [Parameter] public Guid SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "participantId")]
    public Guid ParticipantId { get; set; }

    private SessionParticipant? _participant;
    private bool _editMode;
    private bool _isBusy;
    private string? _error;

    // Stats form
    private int _formStr = 10;
    private int _formDex = 10;
    private int _formCon = 10;
    private int _formInt = 10;
    private int _formWis = 10;
    private int _formCha = 10;

    // Info form
    private string? _formClass;
    private int? _formLevel;
    private string? _formRace;
    private int? _formAge;
    private string? _formBackground;
    private string? _formAlignment;
    private int? _formExperiencePoints;
    private string? _formPersonalityTraits;
    private string? _formIdeals;
    private string? _formBonds;
    private string? _formFlaws;
    private string? _formLanguageProficiencies;
    private string? _formToolProficiencies;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _error = null;
        _participant = await SessionRepository.FindParticipantByIdWithInfoAndStatsAsync(ParticipantId);
        if (_participant is null || _participant.SessionId != SessionId)
        {
            _participant = null;
            _error = "Failed to load participant for this session.";
            return;
        }

        if (_participant.Character is not null)
        {
            InitForms();
        }
    }

    private void InitForms()
    {
        var stats = _participant!.Character!.Stats;
        _formStr = stats?.Strength ?? 10;
        _formDex = stats?.Dexterity ?? 10;
        _formCon = stats?.Constitution ?? 10;
        _formInt = stats?.Intelligence ?? 10;
        _formWis = stats?.Wisdom ?? 10;
        _formCha = stats?.Charisma ?? 10;

        var info = _participant.Character.Info;
        _formClass = info?.Class;
        _formLevel = info?.Level;
        _formRace = info?.Race;
        _formAge = info?.Age;
        _formBackground = info?.Background;
        _formAlignment = info?.Alignment;
        _formExperiencePoints = info?.ExperiencePoints;
        _formPersonalityTraits = info?.PersonalityTraits;
        _formIdeals = info?.Ideals;
        _formBonds = info?.Bonds;
        _formFlaws = info?.Flaws;
        _formLanguageProficiencies = info?.LanguageProficiencies;
        _formToolProficiencies = info?.ToolProficiencies;
    }

    private IEnumerable<(string Label, int Value)> GetStats() =>
    [
        ("STR", _formStr), ("DEX", _formDex), ("CON", _formCon),
        ("INT", _formInt), ("WIS", _formWis), ("CHA", _formCha)
    ];

    private void SetStat(string label, int value)
    {
        switch (label)
        {
            case "STR": _formStr = value; break;
            case "DEX": _formDex = value; break;
            case "CON": _formCon = value; break;
            case "INT": _formInt = value; break;
            case "WIS": _formWis = value; break;
            case "CHA": _formCha = value; break;
        }
    }

    private string GetModifier(int value)
    {
        var mod = (int)Math.Floor((value - 10) / 2.0);
        return mod >= 0 ? $"+{mod}" : $"{mod}";
    }

    private async Task SaveStats()
    {
        _isBusy = true;
        var result = await UpdateStatsService.ExecuteAsync(new UpdateStatsCommand(
            ParticipantId, _formStr, _formDex, _formCon, _formInt, _formWis, _formCha));
        _isBusy = false;
        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        await ReloadAsync();
    }

    private async Task SaveInfo()
    {
        _isBusy = true;
        var result = await UpdateInfoService.ExecuteAsync(new UpdateInfoCommand(
            ParticipantId, _formClass, _formLevel, _formRace, _formAge, _formBackground,
            _formAlignment, _formExperiencePoints, _formPersonalityTraits, _formIdeals,
            _formBonds, _formFlaws, _formLanguageProficiencies, _formToolProficiencies));
        _isBusy = false;
        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        await ReloadAsync();
    }

}