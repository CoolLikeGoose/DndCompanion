@using Domain.Entities
@using Web.Components.Pages.Sessions.Game.Master.Models

@if (_modalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add monster</h5>
                    <button type="button" class="btn-close" @onclick="() => _modalOpen = false"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3 position-relative">
                        <label for="monsterName" class="form-label">Name</label>
                        <input type="text" id="monsterName" class="form-control" value="@_name" autocomplete="off"
                               @oninput="OnNameInput"
                               @onblur="OnNameBlur"/>
                        
                        @if (_suggestions.Count > 0)
                        {
                            <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 1000;">
                                @foreach (var entry in _suggestions)
                                {
                                    <button type="button" class="list-group-item list-group-item-action py-1"
                                            @onmousedown="() => SelectSuggestion(entry)">
                                        @entry.Name <span class="text-muted small">(HP @entry.MaxHp)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="monsterDescription" class="form-label">Description</label>
                        <input type="text" id="monsterDescription" class="form-control" @bind="_description"/>
                    </div>

                    <div class="mb-3">
                        <label for="maxMonsterHp" class="form-label">Max HP</label>
                        <input type="number" id="maxMonsterHp" class="form-control" @bind="_maxHp" min="1"/>
                    </div>

                    @if (_isEdit)
                    {
                        <div class="mb-3">
                            <label for="currentMonsterHp" class="form-label">Current HP</label>
                            <input type="number" id="currentMonsterHp" class="form-control" @bind="_currentHp" min="0"
                                   max="@(_maxHp)"/>
                        </div>
                    }
                    else
                    {
                        if (_bestiaryEntryId is null)
                        {
                            if (IsAuthenticated)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="saveToBestiary" @bind="_saveToBestiary"/>
                                    <label class="form-check-label" for="saveToBestiary">
                                        Save to Bestiary
                                    </label>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small">
                                    Please log in to save monsters to your bestiary.
                                </div>
                            }
                        }
                    }

                    <div class="modal-footer">
                        <button class="btn btn-primary" @onclick="HandleSave">
                            @if (_isEdit)
                            {
                                <span>Save</span>
                            }
                            else
                            {
                                <span>Add</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public Func<string, CancellationToken, Task<List<BestiaryEntry>>>? SearchBestiary { get; set; }
    [Parameter] public EventCallback<MonsterFormData> OnSaved { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }

    private bool _modalOpen = false;
    private bool _isEdit = false;
    private bool _saveToBestiary = false;
    private Guid? _bestiaryEntryId;

    private Guid? _monsterId;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private int _maxHp = 1;
    private int _currentHp = 0;

    public void Open()
    {
        _name = string.Empty;
        _maxHp = 1;
        _description = string.Empty;
        _currentHp = 0;
        _saveToBestiary = false;
        _bestiaryEntryId = null;

        _isEdit = false;
        _modalOpen = true;
    }

    public void Open(Monster monster)
    {
        _monsterId = monster.Id;
        _name = monster.Name;
        _maxHp = monster.MaxHp;
        _currentHp = monster.CurrentHp;
        _description = monster?.Description ?? string.Empty;
        
        _isEdit = true;
        _modalOpen = true;
    }

    // for debouncing
    private CancellationTokenSource? _searchCts;
    private List<BestiaryEntry> _suggestions = new();
    private async Task OnNameInput(ChangeEventArgs e)
    {
        if (SearchBestiary == null) return;
        
        _name = e.Value?.ToString() ?? string.Empty;
        
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            if (token.IsCancellationRequested) return;

            _suggestions = await SearchBestiary.Invoke(_name, token);
            StateHasChanged();
        }
        catch (TaskCanceledException) {}
    }

    private async Task OnNameBlur()
    {
        await Task.Delay(150);
        _suggestions.Clear();
    }

    private void SelectSuggestion(BestiaryEntry entry)
    {
        _name = entry.Name; 
        _bestiaryEntryId = entry.BestiaryEntryId;
        _description = entry.Description ?? string.Empty;
        _maxHp = entry.MaxHp;
        _suggestions.Clear();
    }

    private void HandleSave()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            return;
        }

        OnSaved.InvokeAsync(new MonsterFormData(
            _name,
            _maxHp,
            _currentHp,
            string.IsNullOrWhiteSpace(_description) ? null : _description,
            _isEdit,
            _monsterId,
            _bestiaryEntryId,
            _saveToBestiary
        ));
        _modalOpen = false;
    }
}