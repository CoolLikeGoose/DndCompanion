@using DndCompanion.Application.Features.Characters.Resources.ChangeCharacterResource
@using Domain.Enums

@inject IServiceScopeFactory ScopeFactory

@if (_modalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_isHealing ? "Heal Participant" : "Deal Damage")</h5>
                    <button type="button" class="btn-close" @onclick="() => _modalOpen = false"></button>
                </div>
                <div class="modal-body">
                    <div class="btn-group w-100 mb-3">
                        <button class="btn @(!_isHealing ? "btn-danger" : "btn-outline-danger")"
                                @onclick="() => _isHealing = false">⚔️ Damage</button>
                        <button class="btn @(_isHealing ? "btn-success" : "btn-outline-success")"
                                @onclick="() => _isHealing = true">💚 Heal</button>
                    </div>
                    <input type="number" class="form-control" @bind="_damageValue" min="0" placeholder="Amount"/>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _modalOpen = false">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ApplyDamageHeal">Apply</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public Guid SessionId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    
    private bool _modalOpen = false;
    
    private Guid _targetParticipant;
    private int _damageValue = 0;
    private bool _isHealing = false;

    public void Open(Guid participant)
    {
        _targetParticipant = participant;
        _damageValue = 0;
        _isHealing = false;
        _modalOpen = true;
    }
    
    private async Task ApplyDamageHeal()
    {
        if (_targetParticipant == Guid.Empty || _damageValue <= 0)
            return;
        
        var delta = _isHealing ? _damageValue : -_damageValue;
        
        using var scope = ScopeFactory.CreateScope();
        var service = scope.ServiceProvider.GetRequiredService<ChangeCharacterResourceService>();
        
        await service.ExecuteAsync(new ChangeCharacterResourceCommand(
            ParticipantId: _targetParticipant,
            ResourceType: ResourceType.HitPoints,
            Name: StaticResourceNames.HitPoints,
            Delta: delta
        ));

        _modalOpen = false;
        
        await OnSaved.InvokeAsync();
    }
}