@using DndCompanion.Application.Features.Characters.Resources.ChangeCharacterResource
@using Domain.Enums

@inject IServiceScopeFactory ScopeFactory

@if (_modalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Damage/Heal Participant</h5>
                    <button type="button" class="btn-close" @onclick="() => _modalOpen = false"></button>
                </div>
                <div class="modal-body">
                    @{
                        var afterDamage = Math.Clamp(_currentHp - _outValue, 0, _maxHp);
                        var afterHeal = Math.Clamp(_currentHp + _outValue, 0, _maxHp);

                        var damagePercent = (double)Math.Max(_currentHp - afterDamage, 0) / _maxHp * 100;
                        var healPercent = (double)Math.Max(afterHeal - _currentHp, 0) / _maxHp * 100;
                        var currentPercent = (double)_currentHp / _maxHp * 100;

                        var endGrey = currentPercent - damagePercent;

                        <div>
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>HP</span>
                                <span>@_currentHp/@_maxHp</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-transparent" style="width: @endGrey.ToString("F0")%"></div>
                                <div class="progress-bar bg-danger progress-bar-striped"
                                     style="width: @damagePercent.ToString("F0")%"></div>
                                <div class="progress-bar bg-warning" style="width: 1%;"></div>
                                <div class="progress-bar bg-success progress-bar-striped"
                                     style="width: @healPercent.ToString("F0")%"></div>
                            </div>
                        </div>
                    }

                    <hr/>
                    <div class="text-muted small my-2">Help</div>

                    <div class="input-group">
                        <input type="text" class="form-control w-auto" value="@_valueExpression"
                               @oninput="OnExpressionInput" placeholder="e.g. 1+13-2" @ref="_inputRef"/>
                        <input type="text" class="form-control w-25" disabled value="=@_outValue"/>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-success w-25"
                            @onclick="() => ApplyDamageHeal(isHealing: true)">Heal
                    </button>
                    <button type="button" class="btn btn-secondary w-auto" @onclick="() => _modalOpen = false">Cancel
                    </button>
                    <button type="button" class="btn btn-danger w-25"
                            @onclick="() => ApplyDamageHeal(isHealing: false)">Damage
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public Guid SessionId { get; set; }
    [Parameter] public EventCallback<SessionEvent> OnSaved { get; set; }

    private ElementReference _inputRef;

    private bool _modalOpen = false;

    private Guid _targetParticipant;
    private int _outValue = 0;
    private string? _valueExpression;
    private int _currentHp = 0;
    private int _maxHp = 0;

    public void Open(Guid participantId, int currentHp, int maxHp)
    {
        _targetParticipant = participantId;
        _outValue = 0;
        _valueExpression = null;
        _modalOpen = true;
        _currentHp = currentHp;
        _maxHp = maxHp;

        _ = FocusInputAsync();
    }

    private async Task FocusInputAsync()
    {
        await Task.Delay(50);
        await _inputRef.FocusAsync();
    }

    private void OnExpressionInput(ChangeEventArgs e)
    {
        _valueExpression = e.Value?.ToString() ?? string.Empty;
        var raw = EvaluateExpression(_valueExpression);
        _outValue = Math.Max(0, raw);
    }

    private int EvaluateExpression(string input)
    {
        if (string.IsNullOrWhiteSpace(input) || input.Length > 50) return 0;
        if (!System.Text.RegularExpressions.Regex.IsMatch(input, @"^[\d\+\-\*\/\s\(\)]+$")) return 0;

        try
        {
            var result = new System.Data.DataTable().Compute(input, null);
            return Convert.ToInt32(result);
        }
        catch
        {
            return 0;
        }
    }

    private async Task ApplyDamageHeal(bool isHealing)
    {
        if (_targetParticipant == Guid.Empty || _outValue <= 0)
            return;

        var delta = isHealing ? _outValue : -_outValue;

        using var scope = ScopeFactory.CreateScope();
        var service = scope.ServiceProvider.GetRequiredService<ChangeCharacterResourceService>();

        await service.ExecuteAsync(new ChangeCharacterResourceCommand(
            ParticipantId: _targetParticipant,
            ResourceType: ResourceType.HitPoints,
            Name: StaticResourceNames.HitPoints,
            Delta: delta
        ));

        _modalOpen = false;

        await OnSaved.InvokeAsync(
            new SessionEvent(SessionEventType.ResourcesUpdated, SessionId, _targetParticipant)
        );
    }

}