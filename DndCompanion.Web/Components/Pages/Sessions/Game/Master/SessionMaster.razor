@page "/sessions/{SessionId:guid}/master"
@using DndCompanion.Application.Abstractions.Persistence
@using DndCompanion.Application.Features.Characters.Resources.ApplyRest.ApplyRestParty
@using DndCompanion.Application.Features.Monsters.AddMonster
@using DndCompanion.Application.Features.Monsters.RemoveMonster
@using DndCompanion.Application.Features.Monsters.UpdateMonster
@using Domain.Entities
@using Domain.Enums
@using Web.Components.Shared
@using Web.Components.Pages.Sessions.Game.Master.Modals
@using Web.Components.Pages.Sessions.Game.Master.Models

@inject IServiceScopeFactory ScopeFactory

@inject SessionNotificationService SessionNotificationService

@implements IDisposable

@if (_session is null)
{
    <p>Loading...</p>
}
else
{
    <div class="container py-3">
        @if (_resourceError is not null)
        {
            <div class="alert alert-danger" role="alert">
                @_resourceError
            </div>
        }
        <div class="d-flex justify-content-between mb-3">
            <h3>Characters</h3>
            <div class="btn-group">
                <button class="btn btn-primary"
                        @onclick="() => ApplyRest(true)"
                        disabled="@_isBusy">
                    Long Rest
                </button>
                <button class="btn btn-primary dropdown-toggle"
                        @onclick="() => _restDropdownOpen = !_restDropdownOpen"
                        @onblur="async () => { await Task.Delay(100); _restDropdownOpen = false; }">
                </button>

                @if (_restDropdownOpen)
                {
                    <div class="dropdown-menu show w-100"
                         style="position:absolute; top: 100%; left: 0;">
                        <button class="dropdown-item" @onclick="() => ApplyRest(false)">Short Rest</button>
                    </div>
                }
            </div>
        </div>

        <div class="row g-2">
            @foreach (var participant in _session.Participants.Where(p => p.Role == SessionRole.Player && p.Character is not null))
            {
                var hp = participant.Character!.Resources.FirstOrDefault(r => r.Type == ResourceType.HitPoints);
                <div class="col-6">
                    <div class="card p-3 master-card @GetCardClass()"
                         @onclick="() => OnCardClick(participant)">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="fw-semibold">@participant.Character!.Name</div>
                                <div class="small text-muted">@participant.DisplayName</div>
                            </div>
                            <div>
                                @if (hp is not null && hp.CurrentValue <= 0)
                                {
                                    var successes = participant.Character.DeathSavesSuccesses;
                                    var failures = participant.Character.DeathSavesFailures;

                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="text-muted" style="width: 60px;">Success</span>
                                        @for (int i = 0; i < 3; i++)
                                        {
                                            var filled = i < successes;
                                            <span style="
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 50%;
                                                display: inline-block;
                                                border: 2px solid #198754;
                                                background: @(filled ? "#198754" : "transparent");"></span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="text-muted" style="width: 60px;">Failure</span>
                                        @for (int i = 0; i < 3; i++)
                                        {
                                            var filled = i < failures;
                                            <span style="
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 50%;
                                                display: inline-block;
                                                border: 2px solid #dc3545;
                                                background: @(filled ? "#dc3545" : "transparent");"></span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        @if (hp is not null)
                        {
                            var percent = hp.MaxValue > 0 ? (double)hp.CurrentValue / hp.MaxValue * 100 : 0;
                            var hue = (int)(percent * 1.2);
                            var barStyle = $"width: {percent:F0}%; background-color: hsl({hue}, 80%, 45%);";

                            <div class="mt-2">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>HP</span>
                                    <span>@hp.CurrentValue/@hp.MaxValue</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar" style="@barStyle"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (!_session.Participants.Any(p => p.Role == SessionRole.Player && p.Character is not null))
            {
                <div class="col-12">
                    <p class="text-muted">No players with characters yet.</p>
                </div>
            }
        </div>

        <h3 class="mb-2 mt-4">Monsters</h3>
        <div class="row g-2">
            @foreach(var monster in _monsters)
            {
                <div class="col-6">
                    <MonsterCard
                        Monster="monster" 
                        CardClass="@GetCardClass()"
                        OnCardClick="() => { }"
                        OnDuplicate="HandleMonsterDuplicate"
                        OnRemove="() => HandleMonsterDuplicate(monster)"/>
                </div>
            }
            
            <div class="col-6">
                <button class="btn btn-outline-secondary w-100 h-100" style="min-height: 80px;"
                        @onclick="() => _editMonsterModal.Open()">
                    + Add monster
                </button>
            </div>
        </div>
    </div>

    <div style="position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 1000;">
        <div class="bg-primary p-1 rounded-3 shadow">
            <p class="text-center text-white mb-0">
                Tools
            </p>
            <div class="bg-white rounded-3 p-2">
                <button
                    class="btn w-100 text-start d-flex align-items-center gap-2 tool @(_activeTool == MasterTool.None ? "tool-neutral" : "")"
                    @onclick="() => SelectTool(MasterTool.None)">
                    <i class="bi bi-slash-circle tool-neutral-icon"></i>
                    No tool
                </button>
                <button
                    class="btn w-100 text-start d-flex align-items-center gap-2 tool @(_activeTool == MasterTool.DamageHeal ? "tool-damage" : "")"
                    @onclick="() => SelectTool(MasterTool.DamageHeal)">
                    <i class="bi bi-lightning-fill tool-damage-icon"></i>
                    Damage/Heal
                </button>
                <button
                    class="btn w-100 text-start d-flex align-items-center gap-2 tool @(_activeTool == MasterTool.GiveItem ? "tool-give" : "")"
                    @onclick="() => SelectTool(MasterTool.GiveItem)">
                    <i class="bi bi-bag-plus-fill tool-give-icon"></i>
                    Give Item
                </button>
            </div>
        </div>
    </div>
}

<DamageHealModal @ref="_damageHealModal" SessionId="SessionId" OnSaved="HandleSaved"/>

<GiveItemModal @ref="_giveItemModal" SessionId="@SessionId" OnSaved="HandleSaved"/>

<EditMonsterModal @ref="_editMonsterModal" OnSaved="HandleMonsterSave"/>

<SessionNavBar SessionId="@SessionId" ParticipantId="@ParticipantId" Role="@SessionRole.Master"/>

@code {
    [Parameter] public Guid SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "participantId")]
    public Guid ParticipantId { get; set; }

    private bool _isBusy = false;
    private string? _resourceError = null;
    private Session? _session;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionAsync();
        await LoadMonstersAsync();
        SessionNotificationService.Subscribe(SessionId, OnSessionUpdated);
    }

    private async Task LoadSessionAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<ISessionRepository>();
        _session = await repo.FindByIdWithParticipantsAndCharactersAsync(SessionId);
    }

    private async Task OnSessionUpdated(SessionEvent sessionEvent)
    {
        if (sessionEvent.Type == SessionEventType.ItemsUpdated)
            return;

        await LoadSessionAsync();
        await InvokeAsync(StateHasChanged);
    }

    // ToolBar
    private enum MasterTool
    {
        None,
        DamageHeal,
        GiveItem,
    }

    private MasterTool _activeTool = MasterTool.None;

    private void SelectTool(MasterTool tool)
    {
        _activeTool = tool;
    }

    private string GetCardClass() => _activeTool switch
    {
        MasterTool.DamageHeal => "tool-damage",
        MasterTool.GiveItem => "tool-give",
        _ => ""
    };

    private DamageHealModal _damageHealModal = null!;
    private GiveItemModal _giveItemModal = null!;

    private void OnCardClick(SessionParticipant participant)
    {
        switch (_activeTool)
        {
            case MasterTool.DamageHeal:
                var hp = participant.Character!.Resources.FirstOrDefault(r => r.Type == ResourceType.HitPoints);
                _damageHealModal.Open(participant.Id, participant.Character!.Name, hp?.CurrentValue ?? 0, hp?.MaxValue ?? 0);
                break;
            case MasterTool.GiveItem:
                _giveItemModal.Open(participant.Id, participant.Character!.Name);
                break;
            default:
                break;
        }
    }

    private async Task HandleSaved(SessionEvent sessionEvent)
    {
        await LoadSessionAsync();
        await SessionNotificationService.NotifyAsync(sessionEvent);
    }

    // Rest options
    private bool _restDropdownOpen = false;

    private async Task ApplyRest(bool isLong = true)
    {
        _isBusy = true;
        _resourceError = null;

        // Using scope to resolve an issue with the participant's HP not being updated in current scopedDbContext =>
        // user can't click the rest button more than once (I spent 2 hours of my life)
        using var scope = ScopeFactory.CreateScope();
        var service = scope.ServiceProvider.GetRequiredService<ApplyRestPartyService>();

        var result = await service.ExecuteAsync(
            new ApplyRestPartyCommand(SessionId, isLong ? RecoveryType.LongRest : RecoveryType.ShortRest, true));

        _isBusy = false;

        if (!result.IsSuccess)
        {
            _resourceError = result.ErrorMessage;
            return;
        }

        _restDropdownOpen = false;

        var sessionEvent = new SessionEvent(SessionEventType.RestTaken, SessionId, null,
            new PartyRestLogEntry(DateTime.UtcNow, isLong));

        await SessionNotificationService.NotifyAsync(sessionEvent);
        await OnSessionUpdated(sessionEvent);
    }

    // Monsters
    private List<Monster> _monsters = new();
    private EditMonsterModal _editMonsterModal = null!;

    private async Task LoadMonstersAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<ISessionRepository>();
        var session = await repo.FindByIdWithMonstersAsync(SessionId);
        _monsters = session?.Monsters.ToList() ?? new();
    }

    private async Task HandleMonsterSave(MonsterFormData monsterData)
    {
        using var scope = ScopeFactory.CreateScope();
        if (monsterData.IsEdit)
        {
            var service = scope.ServiceProvider.GetRequiredService<UpdateMonsterService>();
            await service.ExecuteAsync(new UpdateMonsterCommand(
                SessionId,
                monsterData.MonsterId!.Value, 
                monsterData.Name,
                monsterData.MaxHp, 
                monsterData.CurrentHp, 
                monsterData.Description));
        }
        else
        {
            var service = scope.ServiceProvider.GetRequiredService<AddMonsterService>();
            await service.ExecuteAsync(new AddMonsterCommand(
                SessionId,
                monsterData.Name,
                monsterData.MaxHp,
                monsterData.Description));
        }
        
        await LoadMonstersAsync();
    }

    private async Task HandleRemoveMonster(Guid monsterId)
    {
        var scope = ScopeFactory.CreateScope();
        var service = scope.ServiceProvider.GetRequiredService<RemoveMonsterService>();
        await service.ExecuteAsync(new RemoveMonsterCommand(SessionId, monsterId));
        await LoadMonstersAsync();
    }

    private async Task HandleMonsterDuplicate(Monster monster)
    {
        using var scope = ScopeFactory.CreateScope();
        var service = scope.ServiceProvider.GetRequiredService<AddMonsterService>();
        await service.ExecuteAsync(new AddMonsterCommand(SessionId, monster.Name + " (copy)", monster.MaxHp, monster.Description));
        await LoadMonstersAsync();
    }

    public void Dispose()
    {
        SessionNotificationService.Unsubscribe(SessionId, OnSessionUpdated);
    }

}