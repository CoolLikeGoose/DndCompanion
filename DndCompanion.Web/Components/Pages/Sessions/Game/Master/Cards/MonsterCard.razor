@using Domain.Entities

<div class="card p-3 master-card @CardClass" @onclick="OnCardClick">
    <div class="d-flex justify-content-between">
        <div class="d-flex align-items-start gap-2">
            <span class="badge rounded-pill bg-secondary d-flex align-items-center justify-content-center"
                  style="min-width: 24px; height: 24px; font-size: 0.75rem;">
                @Number
            </span>
            <div>
                <div class="fw-semibold">@Monster.Name</div>
                @if (!string.IsNullOrWhiteSpace(Monster.Description))
                {
                    <div class="small text-muted">@Monster.Description</div>
                }
            </div>
        </div>

        <div class="d-flex gap-1">
            <button class="btn btn-sm btn-outline-secondary"
                    @onclick:stopPropagation="true"
                    @onclick="() => OnDuplicate.InvokeAsync(Monster)">
                <i class="bi bi-copy"></i>
            </button>

            <button class="btn btn-sm btn-outline-danger"
                    @onclick:stopPropagation="true"
                    @onclick="() => OnRemove.InvokeAsync(Monster.Id)">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>

    @{
        var percent = Monster.MaxHp > 0 ? (double)Monster.CurrentHp / Monster.MaxHp * 100 : 0;
        var hue = (int)(percent * 1.2);
    }
    <div class="mt-2">
        <div class="d-flex justify-content-between small text-muted mb-1">
            <span>HP</span>
            <span>@Monster.CurrentHp/@Monster.MaxHp</span>
        </div>
        <div class="progress" style="height: 6px;">
            <div class="progress-bar"
                 style="width: @percent.ToString("F0")%; background-color: hsl(@hue, 80%, 45%);"></div>
        </div>
    </div>
</div>

@code {
    [Parameter] public required Monster Monster { get; set; }
    [Parameter] public int Number { get; set; }
    [Parameter] public string CardClass { get; set; } = string.Empty;
    [Parameter] public EventCallback OnCardClick { get; set; }
    [Parameter] public EventCallback<Monster> OnDuplicate { get; set; }
    [Parameter] public EventCallback<Guid> OnRemove { get; set; }
}